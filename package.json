{
  "name": "linear-local-first-cloudflare-boilerplate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A Linear-inspired local-first React/Vite boilerplate deployed on Cloudflare Workers with Durable Object sync.",
  "scripts": {
    "dev": "npm run build && wrangler dev --local --port 8787",
    "dev:local-node": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "dev:api": "tsx server/sync-server.ts",
    "build": "wrangler types && tsc -b && vite build",
    "deploy": "npm run build && wrangler deploy",
    "cf:types": "wrangler types",
    "cf:dry-run": "npm run build && wrangler deploy --dry-run",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "idb": "^8.0.3",
    "lucide-react": "^0.532.0",
    "mobx": "^6.13.7",
    "mobx-react-lite": "^4.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^8.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.107.0",
    "ws": "^8.18.3"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  }
}
