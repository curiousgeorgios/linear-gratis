{
	"name": "integrations-worker-app",
	"version": "0.1.0",
	"private": true,
	"packageManager": "bun@1.4.4",
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build --webpack",
		"build:worker": "opennextjs-cloudflare build",
		"start": "next start",
		"test": "bun test",
		"test:all": "bun scripts/run-test-suite.mjs",
		"test:coverage": "bun scripts/run-test-suite.mjs --coverage-only",
		"test:stress": "bun test --rerun-each=20",
		"test:worker": "bun scripts/test-worker-smoke.mjs",
		"test:smoke": "bun scripts/test-site-smoke.mjs",
		"test:db": "bun scripts/run-supabase-tests.mjs",
		"test:roadmap-votes": "bun test tests/roadmap-vote-lifecycle.test.ts",
		"db:migrate:production": "bun scripts/migrate-production.mjs",
		"release:build": "bun run test:all",
		"release:deploy": "bun run db:migrate:production && wrangler deploy && bun scripts/test-worker-smoke.mjs --live",
		"release:cloudflare:build": "node_modules/@infisical/cli/bin/infisical run --silent --domain=https://infisical.onestack.cloud/api --token=\"$INFISICAL_TOKEN\" --projectId=15892171-18cf-4a7f-b0c3-ad4291a4b395 --env=prod -- bun scripts/run-test-suite.mjs --skip-browser-smoke",
		"release:cloudflare:deploy": "node_modules/@infisical/cli/bin/infisical run --silent --domain=https://infisical.onestack.cloud/api --token=\"$INFISICAL_TOKEN\" --projectId=15892171-18cf-4a7f-b0c3-ad4291a4b395 --env=prod --command 'bun scripts/wait-for-github-release-gate.mjs && bun run release:deploy'",
		"lint": "eslint .",
		"preview": "bun run build:worker && wrangler dev",
		"deploy": "infisical run --env=prod --command 'bun run release:build && bun run release:deploy'",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./env.d.ts",
		"generate-og": "node scripts/generate-og.js"
	},
	"dependencies": {
		"@hookform/resolvers": "^6.0.0",
		"@linear/sdk": "^100.0.0",
		"@radix-ui/react-avatar": "^1.1.10",
		"@radix-ui/react-dialog": "^1.1.17",
		"@radix-ui/react-label": "^2.1.7",
		"@radix-ui/react-popover": "^1.1.17",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-slot": "^1.2.3",
		"@supabase/ssr": "^0.12.0",
		"@supabase/supabase-js": "^2.57.4",
		"@tiptap/extension-list": "^3.26.1",
		"@tiptap/extension-placeholder": "^3.26.1",
		"@tiptap/markdown": "^3.26.1",
		"@tiptap/react": "^3.26.1",
		"@tiptap/starter-kit": "^3.26.1",
		"@types/crypto-js": "^4.2.2",
		"bcryptjs": "^3.0.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"crypto-js": "^4.2.0",
		"encoding": "^0.1.13",
		"motion": "^12.23.13",
		"lucide-react": "^1.0.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-hook-form": "^7.62.0",
		"react-markdown": "^10.1.0",
		"rehype-raw": "^7.0.0",
		"remark-gfm": "^4.0.1",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.3.1",
		"zod": "^4.1.9"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3",
		"@infisical/cli": "0.44.10",
		"@opennextjs/cloudflare": "^1.3.0",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^26.0.0",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^10.0.0",
		"eslint-config-next": "~16.2.12",
		"next": "~16.2.12",
		"postgres": "3.4.9",
		"puppeteer": "^25.0.0",
		"supabase": "2.122.0",
		"tailwindcss": "^4",
		"tw-animate-css": "^1.3.8",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"wrangler": "^4.37.1",
		"@typescript/native": "npm:typescript@7.0.2",
		"@eslint/compat": "^2.1.1"
	},
	"overrides": {
		"postcss": "^8.5.10"
	},
	"trustedDependencies": [
		"@infisical/cli"
	]
}
