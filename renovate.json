{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Australia/Sydney",
  "schedule": ["at any time"],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "automerge": true,
  "platformAutomerge": true,
  "automergeType": "pr",
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "automerge": true
  }
}
