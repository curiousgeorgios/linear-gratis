# Supabase Configuration
# Get these values from your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Encryption Key
# Generate a random 256-bit (32-byte) base64 key for encrypting stored API tokens
# You can generate one with: openssl rand -base64 32
ENCRYPTION_KEY=your-base64-encryption-key-here

# Stable random secret used to pseudonymise client IP metadata on public
# roadmap votes and comments. Generate once with: openssl rand -hex 32
IP_HASH_SALT=your-stable-random-ip-hash-salt

# Cloudflare Configuration (for custom domain verification)
# Get these from your Cloudflare dashboard: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Zone:DNS:Read, Zone:SSL and Certificates:Read
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token-here
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id-here

# App Domain Configuration
# Your main app domain (users will create CNAME records pointing to this)
NEXT_PUBLIC_APP_DOMAIN=linear.gratis

# Inbound feedback webhooks
# Used by POST /api/public-view/:slug/feedback to verify server-to-server
# feedback submissions before creating Linear issues.
# Generate with: openssl rand -hex 32
FEEDBACK_WEBHOOK_SECRET=your-feedback-webhook-secret

# ---------------------------------------------------------------------------
# Session / cookie signing (required in production)
# Generate with: openssl rand -hex 32
ACCESS_COOKIE_SECRET=your-access-cookie-secret

# ---------------------------------------------------------------------------
# Self-hosting (see docs/self-hosting.md; docker/generate-env.mjs writes these)

# Public origin of this deployment. Used for MCP links and Supabase auth redirects.
# APP_URL=https://feedback.example.com

# Address the *server* uses to reach Supabase when it differs from the public
# NEXT_PUBLIC_SUPABASE_URL (for example inside a Docker network).
# SUPABASE_INTERNAL_URL=http://gateway

# Pin the auth cookie name when the server and browser use different Supabase
# URLs. Leave unset on hosted deployments so existing sessions keep working.
# NEXT_PUBLIC_SUPABASE_COOKIE_NAME=linear-gratis-auth

# Sign-in methods on /login: magic_link, github, password (comma separated).
# "password" needs no SMTP server or OAuth app. Default: magic_link,github.
# NEXT_PUBLIC_AUTH_METHODS=password

# Default interface language when the visitor has not chosen one: en or ar.
# Falls back to the browser's Accept-Language header when unset.
# NEXT_PUBLIC_DEFAULT_LOCALE=ar
